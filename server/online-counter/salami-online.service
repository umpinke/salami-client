[Unit]
Description=Salami Client Online-Zaehler
After=network.target

[Service]
Type=simple
User=salami
WorkingDirectory=/opt/salami-online
ExecStart=/usr/bin/node /opt/salami-online/server.mjs
Environment=PORT=8787
# Hinter nginx (salami-client-zaehler.umpinke.de): nur lokal lauschen und die echte IP aus
# X-Forwarded-For lesen. Ohne Proxy: HOST=0.0.0.0 und TRUST_PROXY=0.
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
Restart=always
RestartSec=5

# Obergrenze für den Arbeitsspeicher: der Zähler braucht nur wenige MB, alles darüber ist ein Fehler
# oder ein Angriff – dann beendet systemd ihn und startet ihn neu, statt dass der Server ausgeht.
MemoryMax=128M

# Abschotten: der Dienst braucht nur Netzwerk.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
