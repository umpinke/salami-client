      "binaries/avutil-60.dll": "avutil-60.dll",
      "binaries/swresample-6.dll": "swresample-6.dll",
      "binaries/graphics-hook64.dll": "graphics-hook64.dll",
      "binaries/graphics-hook32.dll": "graphics-hook32.dll",
      "binaries/ffmpeg-LICENSE.txt": "licenses/ffmpeg-LICENSE.txt",
      "binaries/ffmpeg-NOTICE.txt": "licenses/ffmpeg-NOTICE.txt",
